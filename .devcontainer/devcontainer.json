{
	"name": "PLCC Dev Container",
	"image": "mcr.microsoft.com/devcontainers/base:trixie",
	"features": {
		"ghcr.io/devcontainers/features/python:1": {},
		"ghcr.io/devcontainers/features/node:1": {},
		"ghcr.io/devcontainers/features/java:1": { "version": "17" },
		"ghcr.io/devcontainers-extra/features/pdm:2": {},
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
	},
	"remoteUser": "vscode",
	"mounts": [
		"source=ourplcc-dev,target=/workspaces/dev,type=volume",
		"source=ourplcc-change-requests,target=/workspaces/change-requests,type=volume",
		"source=ourplcc-gh,target=/home/vscode/.config/gh,type=volume",
		"source=plcc-ng-claude,target=/home/vscode/.claude,type=volume"
	],
	"containerEnv": {
		"BACKLOG_CWD": "/workspaces/change-requests",
		"GIT_TERMINAL_PROMPT": "0",
		"GIT_CONFIG_COUNT": "5",
		"GIT_CONFIG_KEY_0": "safe.directory",
		"GIT_CONFIG_VALUE_0": "/workspaces/dev",
		"GIT_CONFIG_KEY_1": "safe.directory",
		"GIT_CONFIG_VALUE_1": "/workspaces/change-requests",
		"GIT_CONFIG_KEY_2": "safe.directory",
		"GIT_CONFIG_VALUE_2": "/workspaces/plcc-ng",
		"GIT_CONFIG_KEY_3": "credential.https://github.com.helper",
		"GIT_CONFIG_VALUE_3": "",
		"GIT_CONFIG_KEY_4": "credential.https://github.com.helper",
		"GIT_CONFIG_VALUE_4": "!gh auth git-credential"
	},
	"remoteEnv": {
		"SSH_AUTH_SOCK": ""
	},
	"postCreateCommand": "sudo chown vscode:vscode /home/vscode/.claude /home/vscode/.config /home/vscode/.config/gh && git -C ${containerWorkspaceFolder} status >/dev/null && ${containerWorkspaceFolder}/bin/install/claude-imports.bash && ${containerWorkspaceFolder}/bin/install/shared-clones.bash && ${containerWorkspaceFolder}/bin/install/backlog.bash && git -C /workspaces/dev status >/dev/null && git -C /workspaces/change-requests status >/dev/null",

	"customizations": {
		"codespaces": {
			"repositories": {
				"ourPLCC/dev": { "permissions": { "contents": "write" } },
				"ourPLCC/change-requests": { "permissions": { "contents": "write" } }
			}
		},
		"vscode": {
			"settings":
			{
				"git.terminalAuthentication": false,
				"github.gitAuthentication": false,
				"plantuml.server": "https://www.plantuml.com/plantuml",
				"plantuml.render": "PlantUMLServer",
				"files.insertFinalNewline": true,
				"files.trimTrailingWhitespace": true,
				"python.testing.pytestArgs": [
					"."
				],
				"python.testing.unittestEnabled": false,
				"python.testing.pytestEnabled": true,
				"python.analysis.extraPaths": [
  					"/workspaces/plcc-ng/.venv/lib/python3.13/site-packages"
			]
			},
			"extensions": [
				"charliermarsh.ruff",
				"streetsidesoftware.code-spell-checker",
				"ms-python.vscode-pylance",
				"ms-python.python",
				"ms-python.debugpy",
				"DavidAnson.vscode-markdownlint",
				"GitHub.copilot-chat"
			]
		}
	},

	// VS Code forwards the host's SSH agent on every attach, and no setting
	// turns that off; remove the socket so nothing in the container finds it.
	"postAttachCommand": "rm -f /tmp/vscode-ssh-auth-*.sock",

	"postStartCommand":"${containerWorkspaceFolder}/bin/install/shared-clones.bash; ${containerWorkspaceFolder}/bin/install/backlog.bash --check; curl --proto '=https' --tlsv1.2 -sSf https://get-ghcup.haskell.org | BOOTSTRAP_HASKELL_NONINTERACTIVE=1 BOOTSTRAP_HASKELL_INSTALL_STACK=0 BOOTSTRAP_HASKELL_INSTALL_HLS=0 sh && (grep -q ghcup ~/.bashrc || echo '. ~/.ghcup/env' >> ~/.bashrc) && pdm install"
}
